{
 "format": "parquex-night",
 "version": 1,
 "park": "xp",
 "frame": "local meters of xp/park.json (x east, y up, z south, origin at its center)",
 "when": {
  "modes": [
   "auto",
   "day",
   "night"
  ],
  "auto": "night from 19:00 to 06:00 park time",
  "nightHours": {
   "from": 19,
   "to": 6
  },
  "utcOffsetHours": -5,
  "timeZone": "America/Cancun (UTC−5 all year, no DST)",
  "recheckSeconds": 60,
  "transitionSeconds": 1.5,
  "easing": "k = smoothstep(0, 1, p); p moves linearly 0 ↔ 1 over transitionSeconds",
  "nightClassAbove": 0.5
 },
