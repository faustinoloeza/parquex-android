 "lamps": {
  "file": "lamps.bin",
  "format": "PQL1: u32 count, u32 recordBytes (16); per record f32 x, y, z (y = post foot), u8 kind (0 ground, 1 pier), 3 reserved bytes",
  "count": 64,
  "piers": 0,
  "caps": {
   "high": 2500,
   "medium": 1500,
   "low": 700
  },
  "capRule": "keep record j (0-based) when floor((j + 1) * f) > floor(j * f), f = cap / count (only when count > cap)",
  "style": {
   "postHeight": 4.2,
   "postColor": "#2c3036",
   "pole": {
    "radiusTop": 0.06,
    "radiusBottom": 0.08,
    "sides": 5
   },
   "lantern": {
    "radiusTop": 0.22,
    "radiusBottom": 0.12,
    "height": 0.35,
    "centerAbovePost": 0.12,
    "sides": 5
   },
   "postSink": 0.1,
   "head": {
    "radius": 1.3,
    "minPx": 3.2,
    "aboveGround": 4.35
   },
   "lightMapSize": 1024,
   "poolRadius": 10,
   "pathGlow": 0.34,
   "postDistance": 650,
   "headColor": "#ffc56b",
   "headCore": "#fff5db"
  },
  "head": "additive camera-facing disc, radius head.radius m but at least head.minPx px; d = distance to center (0..1): core = smoothstep(0.42, 0.12, d), halo = (1 - d)^1.6 * 0.85, color = mix(headColor, headCore, core) * (core + halo) * k",
  "visibility": "only when k > 0.001; posts hidden beyond 650 m camera distance (heads stay)"
 },
 "lightMap": {
  "file": "nightlight.png",
  "size": 1024,
  "colorSpace": "sRGB",
  "extent": {
   "x0": -750,
   "z0": -750,
   "size": 1500
  },
  "uv": "u = (x - x0) / size, v = (z - z0) / size (row 0 = north edge, z0)",
  "content": "black, paving.png tinted #ffd9a0 × 0.34, plus a warm radial pool of 10 m per lamp, added and clamped",
  "terrain": "emissive += albedo × light × 2.2 × k (in park-models.glb: nightlight-ground = albedo × light on TEXCOORD_1 of terrain:* and paving; strength 2.2 × k)",
  "water": "web: light map sampled 4, 10 and 18 m further from the viewer (weights 0.5, 0.4, 0.3) × ripple × 3 × k; in park-models.glb: nightlight-water on the water's TEXCOORD_0, strength 1.5 × k (no offset)"
 },
 "water": {
  "day": {
   "sky": "#dcf1fb",
   "shallow": "#78d3d6",
   "deep": "#3f8fc2",
   "lagoon": "#4aaebb",
   "pool": "#94deea",
   "river": "#284066"
  },
  "night": {
   "sky": "#1b2c66",
   "shallow": "#1c4fa0",
   "deep": "#0b2462"
  },
  "inlandNight": "inland water (lagoons, rivers): base × (0.16, 0.22, 0.42), 80 %",
  "nightMultiply": [
   0.0646,
   0.0921,
   0.3746
  ],
  "approximation": "park-models.glb water has its day color in COLOR_0: at night multiply it by mix(1, nightMultiply, k) (baseColorFactor), a simplification of the web shader"
 },
 "map": {
  "nightTint": [
   0.05,
   0.065,
   0.15
